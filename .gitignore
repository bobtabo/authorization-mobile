# Flutter / Dart ビルド生成物
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# コード生成物（build_runner: riverpod_generator / freezed）
*.g.dart
*.freezed.dart

# Flutter メタデータ（flutter create が生成するが不要）
.metadata

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Claude Code（プロジェクト共有設定 settings.json、Skillsのみ管理対象）
.claude/*
!.claude/settings.json
!.claude/skills/

# 環境設定（.env.example は管理対象）
.env
.env.*
!.env.example

# macOS
.DS_Store

# Android（android/.gitignore でも管理されているが念のため）
android/local.properties

# iOS（ios/.gitignore でも管理されているが念のため）
ios/Pods/
ios/.symlinks/

# テストカバレッジ
coverage/

# デモ録画の中間ファイル（GIF は掲載用のため管理対象に含める）
docs/*/demo.mp4
